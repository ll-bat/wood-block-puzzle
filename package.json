{
    "name": "project-webpack",
    "version": "1.0.0",
    "description": "",
    "main": "src/app.js",
    "scripts": {
        "start-dev": "npx webpack --env mode=development",
        "postinstall": "npx webpack",
        "start": "node server.js",
        "test": "vitest run",
        "build:generator": "webpack --config webpack.generator.config.js",
        "generate-puzzles": "npm run build:generator --silent && node dist/tools/generate-puzzles.cjs",
        "build:calibration": "webpack --config webpack.calibration.config.js",
        "calibrate-puzzles": "npm run build:calibration --silent && node dist/tools/calibrate-puzzles.cjs"
    },
    "repository": {
        "type": "git",
