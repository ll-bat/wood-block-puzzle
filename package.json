    "dependencies": {
        "css-loader": "^5.0.1",
        "express": "^4.18.1",
        "serve-static": "^1.15.0",
        "style-loader": "^2.0.0",
        "webpack": "^5.112.0"
    },
    "devDependencies": {
        "vitest": "^5.0.5",
        "webpack-cli": "^7.2.3"
    }
